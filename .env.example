# Example values. Copy this file to .env and fill in your sender's SMTP settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=noreply@example.com
SMTP_USER=noreply@example.com
SMTP_PASSWORD='replace-with-smtp-credential'
# Public HTTPS origin for links in emails. For same-computer testing use http://127.0.0.1:8000.
PUBLIC_URL=https://security.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,security.example.com

# Docker Compose only. Set a strong URL-safe password before the first launch.
POSTGRES_PASSWORD=
